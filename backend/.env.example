# ==========================================================
# CampusOps — Production Deployment (Python Stack)
# Backend Environment Configuration Template
# ==========================================================
# Instructions:
# 1. Copy this file to '.env':
#    cp .env.example .env (or copy .env.example .env on Windows)
# 2. Update the values with your local or production database credentials.
# 3. DO NOT commit your real '.env' file or passwords to version control!

# Application Settings
APP_NAME=CampusOps — Production Deployment (Python Stack)
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=True

# Database Configuration (PostgreSQL)
# Used in local development and production environments
DB_HOST=localhost
DB_PORT=5432
DB_NAME=campusops_db
DB_USER=postgres
DB_PASSWORD=Venki@2005


# Direct Database URL (Optional override)
# If provided, DATABASE_URL takes precedence over individual DB_* settings above.
# Example: postgresql://postgres:your_secure_password_here@localhost:5432/campusops_db
# DATABASE_URL=postgresql://postgres:your_secure_password_here@localhost:5432/campusops_db
