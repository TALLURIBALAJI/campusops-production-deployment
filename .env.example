# ==========================================================
# CampusOps — Production Docker Deployment Configuration
# Copy this file to '.env' and fill in your secure production credentials.
# CRITICAL: DO NOT commit your real '.env' file to version control!
# ==========================================================

# Application Settings
APP_NAME=CampusOps — Production Deployment (Python Stack)
APP_ENV=production
DEBUG=False

# PostgreSQL Container Configuration (Official Postgres Image)
# DB_HOST is set to 'db' inside docker-compose network
POSTGRES_DB=campusops_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_production_password_here

# Internal & External Port Mappings
BACKEND_PORT=8000
HTTP_PORT=80
